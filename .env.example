# Copy this file to `.env` and adjust values for your machine or deployment target.

# Shared environment
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=sokoodds
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# For direct local runs outside Docker, switch the hostname from `postgres` to `localhost`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/sokoodds

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API
API_HOST=localhost
API_PORT=8000
API_V1_PREFIX=/api/v1
REQUIRE_ENGINE_READY_FOR_ORDERS=true
ENGINE_HEALTH_MODE=http
MARKET_ENGINE_HEALTH_URL=http://market-engine:9000/internal/health
ENGINE_HEALTH_FALLBACK_STATUS=ready
ENGINE_HEALTH_FALLBACK_BOOKS_LOADED=3
DEMO_USER_DEFAULT_WALLET_BALANCE=25000.00
SEED_DEMO_MARKETS_ON_STARTUP=true
DARAJA_MODE=sandbox
DARAJA_CONSUMER_KEY=your-safaricom-sandbox-consumer-key
DARAJA_CONSUMER_SECRET=your-safaricom-sandbox-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your-safaricom-sandbox-passkey
DARAJA_CALLBACK_BASE_URL=https://your-public-callback-host.example
DARAJA_CALLBACK_TOKEN=replace-with-a-long-random-callback-token
DARAJA_CALLBACK_ALLOWED_IPS=replace-with-safaricom-callback-ip-ranges
DARAJA_CALLBACK_TRUSTED_PROXY_IPS=127.0.0.1,::1
DARAJA_CALLBACK_SIGNATURE_SECRET=
DARAJA_STUB_AUTO_COMPLETE=false
DARAJA_B2C_INITIATOR_NAME=your-safaricom-b2c-initiator
DARAJA_B2C_SECURITY_CREDENTIAL=your-safaricom-b2c-security-credential
DARAJA_B2C_RESULT_BASE_URL=https://your-public-callback-host.example
DARAJA_B2C_TIMEOUT_BASE_URL=https://your-public-callback-host.example
WITHDRAWAL_REVIEW_THRESHOLD_KES=2500.00
WITHDRAWAL_DAILY_LIMIT_KES=5000.00
REQUIRE_APPROVED_KYC_FOR_ORDERS=false
ADMIN_PHONE_ALLOWLIST=0712345678

# Market engine
ENGINE_HOST=localhost
ENGINE_PORT=9000
ENGINE_HYDRATION_DELAY_MS=750
ENGINE_BOOKS_LOADED=3
ENGINE_LAST_STREAM_OFFSET=orders:0-0

# Worker
WORKER_MODE=all
WORKER_TICK_SECONDS=15
WORKER_HEARTBEAT_FILE=/tmp/sokoodds-worker.heartbeat

# Web
WEB_HOST=localhost
WEB_PORT=3000
SOKOODDS_API_SERVER_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
